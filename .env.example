APP_NAME=Kubii
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
# На продакшені вкажіть реальний домен, наприклад https://kubii.com.ua
# SEO_INDEXING_ENABLED=false

APP_LOCALE=uk
APP_FALLBACK_LOCALE=uk
APP_FAKER_LOCALE=uk_UA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
SLOW_QUERY_LOG_ENABLED=true
SLOW_QUERY_THRESHOLD_MS=50
PREVENT_LAZY_LOADING=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=kubii
DB_USERNAME=kubii
DB_PASSWORD=kubii
DB_ADMIN_BACKUP_ENABLED=true

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=kubii-cache-

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380
REDIS_DB=0
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PASSWORD=null
REDIS_CACHE_PORT=6380
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3
REDIS_PREFIX=kubii-database-
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/auth/google/callback
GOOGLE_ANALYTICS_MEASUREMENT_ID=
GOOGLE_ANALYTICS_ENABLED=true
GOOGLE_CUSTOMER_REVIEWS_ENABLED=false
GOOGLE_MERCHANT_ID=
GOOGLE_CUSTOMER_REVIEWS_DELIVERY_DAYS=3

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT=60

NOVA_POSHTA_API_KEY=
NOVA_POSHTA_SENDER_CITY_REF=
FREE_DELIVERY_THRESHOLD=3000

LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=true
LIQPAY_RESULT_URL=
LIQPAY_SERVER_URL=

MONOBANK_TOKEN=
MONOBANK_API_URL=https://api.monobank.ua
MONOBANK_VERIFY_WEBHOOK=true
MONOBANK_REDIRECT_URL=
MONOBANK_WEBHOOK_URL=

PRODUCT_IMAGE_WEBP_QUALITY=88
PRODUCT_IMAGE_MIRROR_BATCH_SIZE=100
